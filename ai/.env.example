# ==============================================================================
# Semantic Chaos Monkey — Environment Configuration
# ==============================================================================

# --- Primary Configuration: DigitalOcean Serverless Inference (Open-Weight) ---
LLM_BASE_URL=https://inference.do-ai.run/v1
LLM_MODEL=REPLACE_WITH_ID_FROM_list_models
LLM_API_KEY=your_digitalocean_model_access_key
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_BUDGET_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.4

# --- Fixed World Reference Date ---
CHAOS_WORLD_TODAY=2026-01-01

# --- Demo & Offline Switches ---
CHAOS_FIXTURE_MODE=false
CHAOS_FORCE_FALLBACK=false

# --- Alternative Configuration: Local Ollama (Uncomment to use) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=REPLACE_WITH_ID_FROM_list_models
# LLM_API_KEY=ollama
# CHAOS_FIXTURE_MODE=false
# CHAOS_FORCE_FALLBACK=false
